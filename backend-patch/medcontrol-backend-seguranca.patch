diff -u a/src/app/vinculo/page.tsx b/src/app/vinculo/page.tsx
--- a/src/app/vinculo/page.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/vinculo/page.tsx	2026-11-08 11:46:40.990245617 +0000
@@ -0,0 +1,59 @@
+'use client';
+
+import { useEffect, useState } from 'react';
+import { getDeviceId } from '@/lib/device-id';
+
+/**
+ * Mostra o código de vínculo deste dispositivo para usar no app MedControl (Android/iOS):
+ * no app, abra Configurações → "Código de vínculo" e cole este código.
+ * Trate o código como uma senha: quem o tiver acessa os mesmos remédios.
+ */
+export default function VinculoPage() {
+  const [codigo, setCodigo] = useState('');
+  const [visivel, setVisivel] = useState(false);
+  const [copiado, setCopiado] = useState(false);
+
+  useEffect(() => {
+    setCodigo(getDeviceId());
+  }, []);
+
+  const copiar = async () => {
+    try {
+      await navigator.clipboard.writeText(codigo);
+      setCopiado(true);
+      setTimeout(() => setCopiado(false), 2000);
+    } catch {
+      setVisivel(true); // sem permissão de área de transferência: mostra para copiar à mão
+    }
+  };
+
+  return (
+    <main style={{ maxWidth: 480, margin: '0 auto', padding: 24, fontFamily: 'system-ui, sans-serif' }}>
+      <h1 style={{ fontSize: 24, marginBottom: 8 }}>Código de vínculo</h1>
+      <p style={{ opacity: 0.75, lineHeight: 1.5 }}>
+        Use este código no app MedControl (em Configurações → Código de vínculo) para acessar os mesmos remédios neste
+        e em outros aparelhos. <strong>Trate-o como uma senha.</strong>
+      </p>
+      <div
+        style={{
+          margin: '20px 0',
+          padding: 14,
+          borderRadius: 12,
+          border: '1.5px solid rgba(128,128,128,0.4)',
+          wordBreak: 'break-all',
+          fontFamily: 'monospace',
+        }}
+      >
+        {visivel ? codigo || '…' : '••••••••-••••-••••-••••-••••••••••••'}
+      </div>
+      <div style={{ display: 'flex', gap: 10 }}>
+        <button onClick={() => setVisivel((v) => !v)} style={{ flex: 1, padding: 12, borderRadius: 12 }}>
+          {visivel ? 'Ocultar' : 'Mostrar'}
+        </button>
+        <button onClick={copiar} disabled={!codigo} style={{ flex: 1, padding: 12, borderRadius: 12 }}>
+          {copiado ? 'Copiado!' : 'Copiar'}
+        </button>
+      </div>
+    </main>
+  );
+}
